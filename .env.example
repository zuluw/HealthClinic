# --- RABBITMQ CONFIGURATION ---
RABBITMQ_DEFAULT_USER=your_rabbitmq_user
RABBITMQ_DEFAULT_PASS=your_rabbitmq_password

# --- APPOINTMENTS CONFIGURATION ---
APPOINTMENTS_DB_PASSWORD=your_strong_password_here
APPOINTMENTS_DB_CONNECTION=Host=appointments-db;Database=innoclinic-appointments-db;Username=admin;Password=your_strong_password_here

# --- AZURE SERVICE BUS ---
AZURE_SERVICE_BUS_CONNECTION=

# --- AUTH SERVICE CONFIGURATION ---
# JWT Secret Key (Minimum 32 characters)
AUTH_JWT_KEY=your_secret_key_here_at_least_32_chars

# SQL Server SA Password
AUTH_DB_PASSWORD=your_strong_password_here

# Google Auth Secrets
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Connection String for API
AUTH_DB_CONNECTION=Server=auth-db;Database=innoclinic-auth-db;User Id=sa;Password=your_strong_password_here;TrustServerCertificate=True

# --- DOCUMENTS CONFIGURATION ---
DOCUMENTS_DB_PASSWORD=your_strong_password_here
DOCUMENTS_DB_CONNECTION=Host=documents-db;Database=innoclinic-documents-db;Username=admin;Password=your_strong_password_here

