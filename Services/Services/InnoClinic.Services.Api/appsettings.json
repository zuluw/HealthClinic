{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "RabbitMq": {
    "Host": "innoclinic-rabbitmq",
    "Username": "",
    "Password": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "MongoDB",
        "Args": {
          "databaseUrl": "mongodb://logs-db:27017/InnoClinicLogs",
          "collectionName": "ServicesLogs",
          "period": "00:00:02",
          "cappedMaxSizeMb": "50",
          "cappedMaxDocuments": "100000"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  }
}
