{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Jwt": {
    "Issuer": "InnoClinicServer",
    "Audience": "InnoClinicClient"
  },

  "Authentication": {
    "Google": {
      "ClientId": "462254157277-ocevpe6sg8vkhb8cg4fv89c1agr3rl7u.apps.googleusercontent.com"
    }
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "MongoDB",
        "Args": {
          "databaseUrl": "mongodb://logs-db:27017/InnoClinicLogs",
          "collectionName": "AuthLogs",
          "period": "00:00:02",
          "cappedMaxSizeMb": "50",
          "cappedMaxDocuments": "100000"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  }
}